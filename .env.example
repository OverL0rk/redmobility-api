# Copia este archivo como backend/.env y completa los valores reales
# NUNCA subas backend/.env al repositorio

# ── BASE DE DATOS ─────────────────────────────────────────────
# Local (SQLite — desarrollo):
POSTGRES_URL=sqlite+aiosqlite:///./redmobility.db
# Producción (PostgreSQL — docker-compose lo inyecta automáticamente):
# POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/redmobility

# ── STRIPE ────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── BREVO (emails transaccionales) ───────────────────────────
BREVO_API_KEY=
SENDER_EMAIL=noreply@redmobility.com
SENDER_NAME=RedMobility

# ── CORS — dominios autorizados (separados por coma) ─────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3000/redmobility

# ── URLS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000/redmobility

# ── JWT (genera uno: python -c "import secrets; print(secrets.token_hex(32))") ─
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# ── UPLOADS ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
